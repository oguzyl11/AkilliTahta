# Akıllı Tahta — AI Yapılandırma Şablonu
# İleride AI entegrasyonu eklendiğinde kullanılacak.
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Ollama (Yerel AI — opsiyonel)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=phi3:mini

# Online API (opsiyonel)
# AI_PROVIDER=none
# AI_API_KEY=buraya_api_anahtarinizi_yazin
